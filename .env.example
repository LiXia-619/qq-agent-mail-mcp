NODE_ENV=production
PORT=3000

# Public HTTPS origin only; do not include /mcp here.
MCP_PUBLIC_ORIGIN=https://agent-mail.example.com

# Static fallback client for the private ChatGPT connector.
OAUTH_CLIENT_ID=agent-mail-chatgpt
# Copy the exact callback URL shown by ChatGPT while creating the connector.
OAUTH_REDIRECT_URI=https://chatgpt.com/connector/oauth/replace-with-exact-callback

# Generate both values with: npm run generate-secrets
OAUTH_OWNER_CODE_HASH=scrypt$replace-with-generated-hash
OAUTH_SIGNING_SECRET=replace-with-generated-secret-at-least-32-characters

# Optional named bearer tokens for MCP clients that cannot complete OAuth.
# Generate an entry with: npm run generate-client-token -- polaris
# Store multiple entries as a comma-separated cloud secret; never commit real values.
# MCP_CLIENT_TOKENS=polaris:replace-with-generated-token,other-client:replace-with-another-token

# Official Agent Mail CLI settings. Mount a persistent volume at this path.
AGENTLY_CLI_CONFIG_DIR=/data/agently-cli
AGENTLY_WORKSPACE=default
AGENTLY_TIMEOUT_MS=20000

# Optional alternative to browser setup. Set only as a cloud secret.
# AGENTLY_ACCESS_TOKEN=
